/**
 * @file ufsrv_config_generator_fields.c.input
 * @brief Cold catalogue — core ufsrv config and runtime field descriptors.
 *
 * Copyright (C) 2015-2026 unfacd works
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or
 * (at your option) any later version.
 *
 * This file is consumed by ufsrv_config_generator via #include.
 * It is NOT compiled into the server binary.
 *
 * This file decomposes the 'struct ufsrv' into into individual composeable
 * constructs which are composed into two repositories of settable/gettable
 * hot data stores:
 *  extern UfsrvConfigValue ufsrv_config_store[UFSRV_CONFIG_FIELD_COUNT];
 *  extern void *ufsrv_runtime_store[UFSRV_RUNTIME_FIELD_COUNT];
 * This facilitates the layering of runtime config symbols (config file + runtime config types): ufsrv + ufsrvwebsock etc...
 * as the monoloth blends them into one repository with standard interface.
 * See the generated file: ufsrv_config_generated.h
 * Valules marshallled via config file origin can have optional validation rules applied to them.
 * the config file key is used to wire in an adapter function that transforms the config-file stored value to actual c type stored by the config table.
 * in lua: cpu affinity might bestored as: "system_override" in config tabler that's: enum CpuAffinityPolicy
 *
 * Adding a field — worked example: the logger block:
 *   1. Lua schema: key block in etc/core_schema_ufsrv.lua (types, defaults, ranges).
 *   2. Literal (CONFIG only): CONF_FILE_LITERAL_<GROUP>_<KEY> in ufsrv_config_literals_defs.h.
 *        #define CONF_FILE_LITERAL_LOGGER_DRIVER  "logger.driver"
 *   3. Symbol (CONFIG only and only at server end which is the real consumer): one line in data_config_symbols_core_priv.h with the same key,
 *      .type matching the value type, .field_index = UFSRV_CONFIG_FIELD_COUNT (resolved by name).
 *   4. Catalogue: one entry in core_fields[] below. Copy the nearest entry of the same type:
 *        int / size_t / char *     generic lifecycle (GenericInt* / GenericStr*), no hand-written code.
 *        char *                    .type_allocation_sz = buffer incl NUL (paths 1024, formats 4096).
 *        struct / enum / pointer   plus a marshaller UfsrvConfig<Name>AsString_<type> in
 *                                  ufsrv_config_stubs_as_string.c (+ decl in ..._priv.h); the generated
 *                                  accessor delegates to it (UfLogger * -> UfLoggerDescribeConfiguration).
 *        pointer fields            .value_type = UFSRV_CONFIG_VALUE_PTR, .on_teardown = NULL when the
 *                                  handle belongs to the consumer, not the config store.
 *   5. Regenerate + install: ufsrv_config_generate -> ufsrv_config_verify_generated -> ufsrv_config_install.
 *      install rewrites include/.../generated/ and src/.../generated/ and git-adds them; never hand-edit those.
 *   6. Default: .stored_value = { ... } feeds the add-defaults bootstrap pass and the generated read-only
 *      defaults table for both domains.
 *
 * Removing a field:
 *   1. Drop the core_fields[] entry, its literal, its symbol line and the Lua key.
 *   2. Regenerate + install.  Fix consumers of the old accessor.
 */
// @version 64
// @sha     230f5576d045ec937ddf358928b972cbd2b0f89e

