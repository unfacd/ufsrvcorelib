#!/bin/bash
set -e
# ===========================================================================
# pre-commit hook — ufsrv_config version management & regeneration pipeline
#
# Steps owned by the hook:
#   1. Detect changes to version-tracked sources → early exit if none
#   2. Bump VERSION, hash sources, stamp @version / @sha tags
#   3. Delegate build / generate / verify / install to CMake:
#        cmake --build build --target ufsrv_config_all
#
# The CMake target chains (cmake-modules/ufsrv_config_generator.cmake):
#   ufsrv_config_all
#     → ufsrv_config_verify_generated
#         → ufsrv_config_generate
#             → ufsrv_config_verify_catalogue
#     → ufsrv_config_install
# ===========================================================================

# ── Configuration ──────────────────────────────────────────────────────────
ROOT="dev/scripts/ufsrv_config_generator"
VERFILE="${ROOT}/VERSION"
REPO_DIR="$(git rev-parse --show-toplevel)"
BUILD_DIR="${REPO_DIR}/build"

# Version‑tracked sources — changes here trigger the full pipeline.
SOURCES=(
  "${ROOT}/ufsrv_config_generator.c"
  "${ROOT}/ufsrv_config_generator_fields.c.input"
)

# ── Step 0: Detect changes ─────────────────────────────────────────────────
changed=0
for f in "${SOURCES[@]}" ".githooks/pre-commit"; do
  if ! git diff --cached --quiet -- "$f" 2>/dev/null; then changed=1; break; fi
  if ! git diff --quiet -- "$f" 2>/dev/null; then changed=1; break; fi
done

if [ $changed -eq 0 ]; then
  exit 0
fi

echo "pre-commit: ufsrv_config sources changed — running regeneration pipeline"

# ── Step 1: Bump VERSION ───────────────────────────────────────────────────
echo "pre-commit: [1/3] bumping version"
v=$(cat "$VERFILE" 2>/dev/null || echo 0)
v=$((v + 1))
echo "$v" > "$VERFILE"
git add "$VERFILE"

# ── Step 2: Hash sources → .version files, stamp @version / @sha tags ──────
echo "pre-commit: [2/3] hashing sources"
for f in "${SOURCES[@]}"; do
  [ ! -f "$f" ] && continue
  sha=$(git hash-object "$f")
  echo "$sha" > "${f}.version"
  git add "${f}.version"

  # Stamp @version / @sha into sources that carry doxygen‑style tags.
  if grep -q '^// @version ' "$f" 2>/dev/null; then
    sed -i "s|^// @version .*|// @version ${v}|" "$f"
    sed -i "s|^// @sha .*|// @sha     ${sha}|" "$f"
    git add "$f"
  fi
done

# ── Step 3: Delegate build / generate / verify / install to CMake ──────────
echo "pre-commit: [3/3] cmake --build build --target ufsrv_config_all"

if [ ! -f "${BUILD_DIR}/Makefile" ] && [ ! -f "${BUILD_DIR}/build.ninja" ]; then
  echo "pre-commit: ERROR — build directory not configured or not CMake-generated."
  echo "  Run: cmake -B build -DUFSRV_CONFIG_MODULE=ON -DCMAKE_BUILD_TYPE=Debug"
  exit 1
fi

cmake --build "$BUILD_DIR" --target ufsrv_config_all

echo "pre-commit: pipeline complete (version ${v})"
