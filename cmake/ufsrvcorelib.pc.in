prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ufsrvcorelib
Description: Core library for ufsrv platform (CPU affinity, thread management)
Version: @ufsrvcorelib_VERSION@
Requires.private: uflib libcurl json-c openssl libmariadb
Libs: -L${libdir} -lufsrvcorelib
Libs.private: -lm
Cflags: -I${includedir} -I${includedir}/ufsrvcorelib
