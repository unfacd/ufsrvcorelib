# Doxyfile.in — generated by CMake, do not edit
#
# Override OUTPUT_DIRECTORY via cmake: -DDOXYGEN_OUTPUT_DIR=/path

PROJECT_NAME           = "ufnetcorelib"
PROJECT_BRIEF          = "Core library for the unfacd messaging network platform"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@

# ── Input files ────────────────────────────────────────────────────────────
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include/ufnetcorelib \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/ufsrv_configurator
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c
EXCLUDE_PATTERNS       = */build/* */build_test/* */.claude/*

# ── Preprocessing ──────────────────────────────────────────────────────────
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = __BLOCKS__

# ── Output formats ─────────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
HTML_OUTPUT            = html

# ── Extraction ─────────────────────────────────────────────────────────────
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ── Warnings ───────────────────────────────────────────────────────────────
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

# ── Look and feel ──────────────────────────────────────────────────────────
OPTIMIZE_OUTPUT_FOR_C  = YES
CASE_SENSE_NAMES       = YES
JAVADOC_AUTOBRIEF      = YES
